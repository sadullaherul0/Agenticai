---
interface Props {
  baslik: string;
}
const { baslik } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{baslik} · AgenticAI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="ust">
      <a href="/" class="logo">Agentic<span>AI</span></a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --zemin: #f6f4ef;
    --kart: #ffffff;
    --yazi: #1d1b18;
    --soluk: #6b665e;
    --cizgi: #e2ddd3;
    --vurgu: #2f4bd8;
    --vurgu-acik: #e8ecfd;
    --hata: #b42318;
    --radius: 10px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --zemin: #151412;
      --kart: #1e1d1a;
      --yazi: #eeeae2;
      --soluk: #a39d92;
      --cizgi: #34312c;
      --vurgu: #8aa0ff;
      --vurgu-acik: #232a4a;
      --hata: #ff8a80;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--zemin);
    color: var(--yazi);
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
  }
  .ust {
    max-width: 760px;
    margin: 0 auto;
    padding: 24px 16px 0;
  }
  .logo {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 22px;
    color: var(--yazi);
    text-decoration: none;
  }
  .logo span { color: var(--vurgu); }
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 24px 16px 80px;
  }
  h1 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.15;
    margin: 24px 0 8px;
  }
  .giris { color: var(--soluk); margin: 0 0 32px; max-width: 56ch; }
  .buton {
    display: inline-block;
    background: var(--vurgu);
    color: #fff;
    border: 0;
    border-radius: var(--radius);
    padding: 14px 22px;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .buton:disabled { opacity: 0.6; cursor: wait; }
</style>
